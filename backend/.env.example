# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== Database =====
# 改成你本机可用的 MySQL 连接串后执行：npx prisma db push
DATABASE_URL="mysql://root:root@localhost:3306/dazi?schema=public"

# ===== JWT =====
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ===== WeChat MP =====
WX_APPID=""
WX_SECRET=""

# ===== Local preview only =====
# 仅在执行 npm run seed:admin-preview 时使用，生产环境不要创建演示管理员。
ADMIN_PREVIEW_PASSWORD=""
