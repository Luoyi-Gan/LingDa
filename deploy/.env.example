# 灵搭 LingDa —— 后端环境变量（生产）
# 把这份复制为 .env 后填入真实值，权限 chmod 600

# ===== Server =====
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# ===== Database (RDS 内网 endpoint) =====
# 阿里云 RDS 控制台 → 实例详情 → 数据库连接 → 内网地址
# 格式：mysql://<user>:<pw>@<endpoint>:3306/<db>?连接参数
DATABASE_URL=mysql://dazi_app:REPLACE_ME_PW@rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/dazi?charset=utf8mb4&serverVersion=8.0.0&timezone=%2B08%3A00

# ===== JWT =====
# setup-ecs.sh 会自动用 openssl rand -hex 32 生成，并替换 REPLACE_ME_JWT
JWT_SECRET=REPLACE_ME_JWT
JWT_EXPIRES_IN=7d

# ===== CORS / 站点 URL =====
# 多个来源使用英文逗号分隔，不允许填 *
CORS_ORIGINS=https://lingda.example.edu.cn,https://lingda-admin.example.edu.cn

# ===== 持久化文件 =====
# 这两个目录必须在部署和回滚之外独立挂载。
PUBLIC_UPLOAD_DIR=/srv/lingda-data/public-uploads
PRIVATE_UPLOAD_DIR=/srv/lingda-data/private-uploads

# 生产环境默认关闭 Swagger；只有校内调试时临时开启
ENABLE_SWAGGER=false
